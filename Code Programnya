# 1. POHON BINER DENGAN 7 SIMPUL
# ====================================

class Node:
    """Class untuk node pohon biner"""
    def __init__(self, value):
        self.value = value
        self.left = None
        self.right = None

class BinaryTree:
    """Class untuk pohon biner"""
    def __init__(self):
        self.root = None
    
    def inorder_traversal(self, node, result=None):
        """Traversal in-order (kiri-root-kanan)"""
        if result is None:
            result = []
        if node:
            self.inorder_traversal(node.left, result)
            result.append(node.value)
            self.inorder_traversal(node.right, result)
        return result
    
    def preorder_traversal(self, node, result=None):
        """Traversal pre-order (root-kiri-kanan)"""
        if result is None:
            result = []
        if node:
            result.append(node.value)
            self.preorder_traversal(node.left, result)
            self.preorder_traversal(node.right, result)
        return result
    
    def postorder_traversal(self, node, result=None):
        """Traversal post-order (kiri-kanan-root)"""
        if result is None:
            result = []
        if node:
            self.postorder_traversal(node.left, result)
            self.postorder_traversal(node.right, result)
            result.append(node.value)
        return result
    
    def visualize(self, node, prefix="", is_left=True):
        """Visualisasi pohon"""
        if node is None:
            return ""
        
        result = ""
        result += prefix
        result += "├── " if is_left else "└── "
        result += str(node.value) + "\n"
        
        new_prefix = prefix + ("│   " if is_left else "    ")
        
        if node.left or node.right:
            if node.left:
                result += self.visualize(node.left, new_prefix, node.right is not None)
            if node.right:
                result += self.visualize(node.right, new_prefix, False)
        
        return result

# Membuat pohon biner dengan 7 simpul
def create_binary_tree():
    tree = BinaryTree()
    tree.root = Node('A')
    tree.root.left = Node('B')
    tree.root.right = Node('C')
    tree.root.left.left = Node('D')
    tree.root.left.right = Node('E')
    tree.root.right.left = Node('F')
    tree.root.right.right = Node('G')
    return tree

# ====================================
# 2. SPANNING TREE CHECKER
# ====================================

class Graph:
    """Class untuk graf"""
    def __init__(self, vertices):
        self.V = vertices  # Jumlah vertex
        self.adj = [[] for _ in range(vertices)]  # Adjacency list
    
    def add_edge(self, u, v):
        """Menambahkan edge antara u dan v (undirected)"""
        self.adj[u].append(v)
        self.adj[v].append(u)
    
    def dfs_util(self, v, visited):
        """DFS helper untuk mengecek konektivitas"""
        visited[v] = True
        for neighbor in self.adj[v]:
            if not visited[neighbor]:
                self.dfs_util(neighbor, visited)
    
    def is_connected(self):
        """Cek apakah graf terhubung"""
        visited = [False] * self.V
        
        # Cari vertex yang memiliki edge
        start_vertex = -1
        for i in range(self.V):
            if len(self.adj[i]) > 0:
                start_vertex = i
                break
        
        if start_vertex == -1:
            return False
        
        # Lakukan DFS dari vertex awal
        self.dfs_util(start_vertex, visited)
        
        # Cek apakah semua vertex dengan edge sudah dikunjungi
        for i in range(self.V):
            if len(self.adj[i]) > 0 and not visited[i]:
                return False
        
        return True
    
    def count_edges(self):
        """Hitung jumlah edge"""
        count = 0
        for i in range(self.V):
            count += len(self.adj[i])
        return count // 2  # Dibagi 2 karena undirected graph
    
    def has_multiple_spanning_trees(self):
        """
        Cek apakah graf memiliki lebih dari satu spanning tree
        
        Aturan:
        - Graf harus terhubung untuk memiliki spanning tree
        - Jika jumlah edge = V-1, graf adalah pohon (tepat 1 spanning tree)
        - Jika jumlah edge > V-1, graf memiliki siklus (lebih dari 1 spanning tree)
        """
        if not self.is_connected():
            return False, "Graf tidak terhubung, tidak memiliki spanning tree"
        
        edges = self.count_edges()
        min_edges = self.V - 1  # Jumlah edge minimum untuk spanning tree
        
        if edges == min_edges:
            return False, f"Graf adalah pohon (tepat 1 spanning tree)"
        elif edges > min_edges:
            return True, f"Graf memiliki siklus ({edges} edges > {min_edges} minimum)"
        else:
            return False, "Graf tidak terhubung"

