    print("       / \\")
    print("      B   C")
    print("     / \\ / \\")
    print("    D  E F  G")
    
    print("\nVisualisasi:")
    print(tree.visualize(tree.root))
    
    print("Traversal:")
    print(f"In-order:   {tree.inorder_traversal(tree.root)}")
    print(f"Pre-order:  {tree.preorder_traversal(tree.root)}")
    print(f"Post-order: {tree.postorder_traversal(tree.root)}")
    
    print("\n" + "=" * 50)
    print("2. PENGECEKAN SPANNING TREE")
    print("=" * 50)
    
    # Contoh 1: Graf dengan siklus (memiliki > 1 spanning tree)
    print("\nContoh 1: Graf dengan Siklus")
    print("Graf:")
    print("  0---1")
    print("  |   |")
    print("  2---3")
    
    graph1 = Graph(4)
    graph1.add_edge(0, 1)
    graph1.add_edge(1, 3)
    graph1.add_edge(3, 2)
    graph1.add_edge(2, 0)
    
    has_multiple, reason = graph1.has_multiple_spanning_trees()
    print(f"\nTerhubung: {graph1.is_connected()}")
    print(f"Jumlah edges: {graph1.count_edges()}")
    print(f"Minimum edges untuk spanning tree: {graph1.V - 1}")
    print(f"Hasil: {'MEMILIKI > 1 spanning tree' if has_multiple else 'TIDAK memiliki > 1 spanning tree'}")
    print(f"Alasan: {reason}")
    
    # Contoh 2: Graf yang sudah merupakan pohon (tepat 1 spanning tree)
    print("\n" + "-" * 50)
    print("Contoh 2: Graf yang Merupakan Pohon")
    print("Graf:")
    print("  0---1---2")
    print("      |")
    print("      3")
    
    graph2 = Graph(4)
    graph2.add_edge(0, 1)
    graph2.add_edge(1, 2)
    graph2.add_edge(1, 3)
    
    has_multiple, reason = graph2.has_multiple_spanning_trees()
    print(f"\nTerhubung: {graph2.is_connected()}")
    print(f"Jumlah edges: {graph2.count_edges()}")
    print(f"Minimum edges untuk spanning tree: {graph2.V - 1}")
    print(f"Hasil: {'MEMILIKI > 1 spanning tree' if has_multiple else 'TIDAK memiliki > 1 spanning tree'}")
    print(f"Alasan: {reason}")
    
    # Contoh 3: Graf tidak terhubung
    print("\n" + "-" * 50)
    print("Contoh 3: Graf Tidak Terhubung")
    print("Graf:")
    print("  0---1    2---3")
    
    graph3 = Graph(4)
    graph3.add_edge(0, 1)
    graph3.add_edge(2, 3)
    
    has_multiple, reason = graph3.has_multiple_spanning_trees()
    print(f"\nTerhubung: {graph3.is_connected()}")
    print(f"Jumlah edges: {graph3.count_edges()}")
    print(f"Hasil: {'MEMILIKI > 1 spanning tree' if has_multiple else 'TIDAK memiliki > 1 spanning tree'}")
    print(f"Alasan: {reason}")
    
    print("\n" + "=" * 50)
    print("KESIMPULAN:")
    print("- Graf memiliki > 1 spanning tree jika terhubung DAN memiliki siklus")
    print("- Graf memiliki tepat 1 spanning tree jika graf adalah pohon")
    print("- Graf tidak memiliki spanning tree jika tidak terhubung")
    print("=" * 50)

if __name__ == "__main__":
